{
  "extends": "./base/configs/tsconfig.base.json",
  "include": [
    "packages/@aglabo/*/src",
    "shared/packages/*/src",
    "configs",
    "base/configs",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "dist",
    ".cache"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./.cache/tsbuildinfo"
  }
}
