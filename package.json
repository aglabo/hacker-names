{
  "name": "@aglabo/hacker-names",
  "version": "0.0.1",
  "private": true,
  "description": "naming library using hacker names",
  "keywords": [
    "library",
    "oss",
    "development"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aglabo/hacker-names.git"
  },
  "license": "MIT",
  "author": "atsushifx",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "hacker-names": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "bash ./scripts/setup-dev-env.sh",
    "clean:dist": "pnpm rimraf dist",
    "scan:secrets": "concurrently --raw --group \"bash runners/run-betterleaks.sh\" \"secretlint\"",
    "check:dprint": "dprint check --list-different",
    "check:dprint:diff": "dprint check",
    "format:dprint": "dprint fmt",
    "check:sh": "cross-env MSYS=NOGLOB bash runners/run-shfmt.sh --list ",
    "format:sh": "cross-env MSYS=NOGLOB bash runners/run-shfmt.sh --format ",
    "lint:sh": "cross-env MSYS=NOGLOB bash runners/run-shellcheck.sh ",
    "test:sh": "bash runners/run-shellspec.sh ",
    "test:sh:all": "bash runners/run-shellspec.sh all",
    "lint:gha": "concurrently --raw --group \"pnpm run lint:gha:actions\" \"pnpm run lint:gha:workflows\"",
    "lint:gha:actions": "bash runners/run-actionlint.sh ",
    "lint:gha:workflows": "concurrently --raw --group \"bash runners/run-ghalint.sh run\" \"bash runners/run-ghalint.sh act\"",
    "lint:spells": "cspell --config .vscode/cspell.json --cache --cache-location .cache/cspell/cSpellCache ",
    "lint:text": "cross-env MSYS='NOGLOB' bash runners/run-textlint.sh ",
    "lint:markdown": "cross-env MSYS='NOGLOB' bash runners/run-markdownlint.sh ",
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "lint:ts": "oxlint -c configs/oxlint.config.ts",
    "lint:ts:fix": "oxlint -c configs/oxlint.config.ts --fix",
    "build": "tsdown --config configs/tsdown.config.ts",
    "test": "pnpm run test:unit && pnpm run test:functional && pnpm run test:integration && pnpm run test:e2e",
    "test:unit": "vitest run --config ./configs/vitest.config.unit.ts",
    "test:coverage:unit": "vitest run --coverage --config ./configs/vitest.config.unit.ts",
    "test:functional": "vitest run --config ./configs/vitest.config.functional.ts",
    "test:coverage:functional": "vitest run --coverage --config ./configs/vitest.config.functional.ts",
    "test:integration": "vitest run --config ./configs/vitest.config.integration.ts",
    "test:coverage:integration": "vitest run --coverage --config ./configs/vitest.config.integration.ts",
    "test:e2e": "pnpm build && vitest run --config ./configs/vitest.config.e2e.ts",
    "test:coverage:e2e": "vitest run --coverage --config ./configs/vitest.config.e2e.ts",
    "test:unit:watch": "vitest --config ./configs/vitest.config.unit.ts",
    "dict:import": "tsx scripts/import-dict.ts",
    "dict:check": "pnpm dict:import && git diff --exit-code dict/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "oxlint": "^1.94.0",
    "tsdown": "^0.23.7",
    "tsrs": "7.1.0-beta.tsrs4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "@(#)": "naming library using hacker names"
}
