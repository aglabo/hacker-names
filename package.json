{
  "name": "hacker-names-workspace",
  "version": "0.0.1",
  "private": true,
  "description": "naming library using hacker names",
  "keywords": [
    "library",
    "oss",
    "development"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aglabo/hacker-names.git"
  },
  "license": "MIT",
  "author": "atsushifx",
  "type": "module",
  "scripts": {
    "prepare": "bash ./scripts/setup-dev-env.sh",
    "clean:dist": "pnpm -r run clean:dist",
    "scan:secrets": "concurrently --raw --group \"bash runners/run-betterleaks.sh\" \"secretlint\"",
    "check:dprint": "dprint check --list-different",
    "check:dprint:diff": "dprint check",
    "format:dprint": "dprint fmt",
    "check:sh": "cross-env MSYS=NOGLOB bash runners/run-shfmt.sh --list ",
    "format:sh": "cross-env MSYS=NOGLOB bash runners/run-shfmt.sh --format ",
    "lint:sh": "cross-env MSYS=NOGLOB bash runners/run-shellcheck.sh ",
    "test:sh": "bash runners/run-shellspec.sh ",
    "test:sh:all": "bash runners/run-shellspec.sh all",
    "lint:gha": "concurrently --raw --group \"pnpm run lint:gha:actions\" \"pnpm run lint:gha:workflows\"",
    "lint:gha:actions": "bash runners/run-actionlint.sh ",
    "lint:gha:workflows": "concurrently --raw --group \"bash runners/run-ghalint.sh run\" \"bash runners/run-ghalint.sh act\"",
    "lint:spells": "cspell --config .vscode/cspell.json --cache --cache-location .cache/cspell/cSpellCache ",
    "lint:text": "cross-env MSYS='NOGLOB' bash runners/run-textlint.sh ",
    "lint:markdown": "cross-env MSYS='NOGLOB' bash runners/run-markdownlint.sh ",
    "lint:types": "tsrs --noEmit -p tsconfig.json",
    "lint:filenames": "ls-lint --config ./configs/ls-lint.yaml",
    "lint": "oxlint -c configs/oxlint.config.ts",
    "lint:fix": "oxlint -c configs/oxlint.config.ts --fix",
    "dev": "tsx packages/@aglabo/cli/src/cli.ts",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test:unit",
    "test:functional": "pnpm -r run test:functional",
    "test:integration": "pnpm -r run test:integration",
    "test:e2e": "pnpm -r run test:e2e",
    "test:coverage:unit": "pnpm -r run test:coverage:unit",
    "test:coverage:functional": "pnpm -r run test:coverage:functional",
    "test:coverage:integration": "pnpm -r run test:coverage:integration",
    "test:coverage:e2e": "pnpm -r run test:coverage:e2e",
    "sync:configs": "pnpm exec tsx scripts/sync-package-scripts.ts",
    "sync:configs:all": "pnpm -r run sync:configs"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@ls-lint/ls-lint": "^2.3.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "oxlint": "^1.94.0",
    "tsdown": "^0.23.7",
    "tsrs": "7.1.0-beta.tsrs4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "@(#)": "naming library using hacker names"
}
